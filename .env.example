# ==========================================
# DevTrack Application Environment Configuration
# ==========================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="DevTrack Backend"
API_V1_STR=/api/v1
SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=devtrack_user
POSTGRES_PASSWORD=devtrack_password
POSTGRES_DB=devtrack_db
DATABASE_URL=postgresql+asyncpg://devtrack_user:devtrack_password@localhost:5432/devtrack_db
DATABASE_SYNC_URL=postgresql://devtrack_user:devtrack_password@localhost:5432/devtrack_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Security / JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Rate Limiting
RATE_LIMIT_LOGIN_MAX_REQUESTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_MAX_REQUESTS=3
RATE_LIMIT_REGISTER_WINDOW_SECONDS=60

# Celery Background Tasks
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
